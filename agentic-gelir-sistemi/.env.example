# Bu bir ŞABLON. Gerçek .env dosyasını kopyalayıp doldur, ASLA commit etme (.gitignore'da).
# cp .env.example .env

# mock  = API çağrısı yok, kuruş harcanmaz (şu anki test modu)
# api    = gerçek Claude API (ANTHROPIC_API_KEY gerekir)
LLM_MODE=mock

# Gerçek moda geçince doldurulur:
# ANTHROPIC_API_KEY=sk-ant-...
